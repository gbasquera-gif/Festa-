generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  CLIENT
  ADMIN
  OPS
}

enum EventType {
  ANIVERSARIO
  CHA_DE_BEBE
  CHA_REVELACAO
  BATIZADO
  OUTRO
}

enum ProductCategory {
  DECORACAO
  MOBILIARIO
  LOUCA
  ILUMINACAO
  BRINQUEDO
  OUTRO
}

enum Fulfillment {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  CART
  REQUESTED
  CONFIRMED
  CANCELLED
}

/// Etapas operacionais de uma reserva, na ordem em que acontecem.
/// Não guarda situação de pagamento: isso vive nos registros de Payment,
/// porque uma reserva pode estar em PREPARING com ou sem o sinal pago, e
/// juntar as duas coisas num enum só criaria estados impossíveis.
enum ReservationStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  REJECTED
  CANCELLED
}

/// Por onde a venda foi fechada.
///
/// A loja Web deduz a origem do link (utm_source); as vendas de balcão,
/// WhatsApp e indicação só existem se alguém digitar. Sem este campo, tudo
/// que a Maria Luiza fecha por fora do app fica invisível no funil — e o
/// canal que mais vende passa a ser o que menos aparece no relatório.
enum SaleChannel {
  WEB
  WHATSAPP
  INSTAGRAM
  INDICACAO
  PRESENCIAL
  TELEFONE
  OUTRO
}

enum PartnerType {
  DECORADOR
  DOCERIA
  FOTOGRAFO
  DJ
  BARTENDER
  ESCOLA
  EMPRESA
  OUTRO
}

enum PaymentMethod {
  PIX
  CARTAO
  BOLETO
  OUTRO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentType {
  /// Comprovadamente sinal.
  DEPOSIT

  /// Comprovadamente saldo.
  BALANCE

  /// Dinheiro comprovadamente recebido, sem informação suficiente para dizer
  /// se foi sinal, saldo ou pagamento único.
  ///
  /// Existe por causa de um caso real: um contrato do painel antigo estava
  /// marcado "Pago" com o campo de sinal zerado. O dinheiro entrou — isso é
  /// certo — mas a origem não guarda em quantas parcelas nem em que papel.
  /// Sem este valor a carga teria de escolher entre duas afirmações falsas:
  /// chamar de sinal um valor que a origem diz ser zero, ou chamar de saldo
  /// um pagamento sem sinal antes dele.
  ///
  /// Conta como recebido e abate o saldo, como qualquer pagamento. Não é
  /// sinal nem saldo, e a tela o mostra como recebimento histórico não
  /// classificado. Vendas novas continuam usando DEPOSIT e BALANCE.
  INDETERMINADO
}

/// Se um registro nasceu aqui ou veio de fora.
///
/// Valida política comercial quem responde "devemos aceitar este negócio?" —
/// pergunta que só faz sentido antes do acordo. Sobre um acordo já cumprido
/// e importado, ela não protege ninguém: ou bloqueia o registro, ou obriga a
/// adulterar o dado para ele passar. Ver docs/MIGRACAO-DE-HISTORICO.md.
enum OrigemDoRegistro {
  /// Nasceu aqui e passou por todas as regras vigentes.
  OPERACAO

  /// Fato consumado, importado de sistema anterior. Integridade foi conferida;
  /// política comercial, não.
  MIGRACAO
}

// ---------- Models ----------

// Os campos @unique deste schema (User.email, Theme.slug, Product.slug,
// Kit.slug) valem para o banco inteiro, o que está correto enquanto houver
// uma empresa só. Se a plataforma um dia atender outras empresas, eles
// precisam virar únicos por empresa — ver docs/VISAO-SAAS.md §6.1 e §6.2,
// onde o caso de User.email tem consequência de produto, não só de banco.
// Enquanto isso: não acrescente @unique global novo em tabela de catálogo.

model User {
  id String @id @default(cuid())

  /// Opcionais porque nem todo cliente da Festaê tem conta no app.
  ///
  /// Quem fecha por WhatsApp passa nome e telefone, e mais nada. Antes, para
  /// registrar essa venda, seria preciso inventar um e-mail e uma senha —
  /// dado falso no banco, que depois aparece na lista de clientes e no
  /// relatório como se fosse verdade. Sem senha a conta simplesmente não
  /// entra pelo login, que é o comportamento correto: ela não é um acesso,
  /// é um cadastro de cliente.
  ///
  /// O e-mail continua único quando existe. Vários nulos convivem no índice
  /// único do Postgres, então clientes sem e-mail não brigam entre si.
  email        String?   @unique
  passwordHash String?
  name         String
  phone        String?
  role         Role      @default(CLIENT)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  // Conta excluída pelo próprio usuário. Os dados pessoais são apagados no
  // ato (nome, e-mail, telefone, endereço); a linha permanece para não
  // derrubar em cascata pedidos e reservas que a empresa ainda precisa
  // cumprir e guardar por obrigação fiscal.
  deletedAt    DateTime?

  // Prova de consentimento exigida pela LGPD: não basta saber que aceitou,
  // é preciso saber QUANDO e QUAL versão do texto estava valendo. Sem a
  // versão, publicar termos novos apagaria o histórico do que foi aceito.
  termsAcceptedAt      DateTime?
  termsAcceptedVersion String?

  // Momento da última troca de senha. Token emitido antes disso para de
  // valer: sem esta marca, redefinir a senha de quem teve a conta invadida
  // não expulsaria o invasor — ele seguiria dentro até o token expirar.
  passwordChangedAt DateTime?

  events              Event[]
  orcamentos          Orcamento[]
  tarefasFeitas       ReservationTask[]
  reservasCanceladas  Reservation[]      @relation("ReservasCanceladas")
  excecoesAutorizadas ExcecaoComercial[] @relation("ExcecoesAutorizadas")

  @@map("users")
}

model Theme {
  id                  String      @id @default(cuid())
  name                String
  slug                String      @unique
  description         String?
  coverImageUrl       String?
  colorPalette        String[]    @default([])
  suggestedEventTypes EventType[] @default([])
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  kits       Kit[]
  events     Event[]
  orcamentos Orcamento[]

  @@map("themes")
}

model Event {
  id           String    @id @default(cuid())
  userId       String
  type         EventType
  date         DateTime
  // Opcional: perguntar quantos convidados logo no primeiro passo travava
  // quem ainda não fechou a lista. Vazio significa "a combinar", e a
  // operação acerta o número pelo WhatsApp antes de separar os itens.
  guestCount   Int?
  budgetGoal   Decimal?  @db.Decimal(10, 2)
  themeId      String?
  address      String?
  neighborhood String?
  city         String    @default("Chapecó")
  state        String    @default("SC")

  /// De onde veio quem montou esta festa, lido do link de origem.
  ///
  /// Fica na festa, e não só no evento de visita, porque é o que liga a
  /// origem ao dinheiro: sem isso dá para saber quantas pessoas o Instagram
  /// trouxe, mas não quantas reservaram nem quanto gastaram — que é a única
  /// versão da pergunta que ajuda a decidir onde divulgar.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  /// Por onde a venda foi fechada. Diferente do utm_source: a UTM diz que
  /// anúncio trouxe a pessoa até a loja, e este campo diz onde o dinheiro
  /// foi combinado. Uma venda pode nascer de um anúncio no Instagram e ser
  /// fechada no WhatsApp — são duas perguntas, e o painel responde as duas.
  saleChannel SaleChannel @default(WEB)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme Theme? @relation(fields: [themeId], references: [id])
  order Order?

  @@index([userId])
  @@index([themeId])
  @@map("events")
}

model Product {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  description   String?
  category      ProductCategory @default(OUTRO)
  unitPrice     Decimal         @db.Decimal(10, 2)
  stockQuantity Int             @default(0)
  imageUrl      String?
  partnerId     String?
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  partner    Partner?     @relation(fields: [partnerId], references: [id])
  kitLinks       KitProduct[]
  orderItems     OrderItem[]
  orderKitItems  OrderKitItem[]
  orcamentoItens OrcamentoItem[]

  @@index([partnerId])
  @@map("products")
}

model Kit {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  themeId       String?
  basePrice     Decimal  @db.Decimal(10, 2)
  coverImageUrl String?
  images        String[] @default([])
  minGuests     Int      @default(0)
  maxGuests     Int      @default(9999)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  theme      Theme?       @relation(fields: [themeId], references: [id])
  products   KitProduct[]
  orders     Order[]
  orcamentos Orcamento[]

  @@index([themeId])
  @@map("kits")
}

model KitProduct {
  id        String @id @default(cuid())
  kitId     String
  productId String
  quantity  Int    @default(1)

  kit     Kit     @relation(fields: [kitId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([kitId, productId])
  @@map("kit_products")
}

model Order {
  id             String      @id @default(cuid())
  eventId        String      @unique
  kitId          String?
  status         OrderStatus @default(CART)
  subtotalKit    Decimal     @default(0) @db.Decimal(10, 2)
  subtotalExtras Decimal     @default(0) @db.Decimal(10, 2)

  /// Retirada na sede ou entrega no local. Padrão retirada: é o que a
  /// operação faz sempre, entrega depende de disponibilidade e de a festa
  /// ser em Chapecó.
  fulfillment Fulfillment @default(PICKUP)
  assembly    Boolean     @default(false)

  /// Taxas gravadas no pedido, e não lidas da tabela de preços na hora de
  /// exibir: se a Festaê reajustar a entrega, quem já reservou continua
  /// pagando o que combinou.
  deliveryFee Decimal @default(0) @db.Decimal(10, 2)
  assemblyFee Decimal @default(0) @db.Decimal(10, 2)

  /// Ajuste comercial do fechamento, positivo ou negativo.
  ///
  /// A venda por WhatsApp fecha num número redondo: R$ 1.190 de composição
  /// viram R$ 1.100 para ganhar a festa, ou R$ 1.300 porque a cliente pediu
  /// algo a mais. Sem esta coluna, a diferença só teria dois lugares para ir
  /// — inflar o preço dos produtos ou virar "desconto" —, e os dois mentem:
  /// um falsifica o valor do acervo vendido, o outro dá sinal a uma
  /// diferença que pode ser para cima.
  ///
  /// Com ela, `total` = produtos + entrega + montagem − desconto + ajuste, e
  /// cada parcela continua valendo o que vale num relatório.
  ajusteComercial Decimal @default(0) @db.Decimal(10, 2)

  /// Quando a composição do kit foi congelada neste pedido.
  ///
  /// Preenchido quando o pedido vira reserva (e de novo só se a própria
  /// reserva trocar de kit numa edição deliberada). A partir daí o que o
  /// pedido compromete é `kitItems`, e não o cadastro atual do kit: mudar o
  /// Kit Essencial amanhã não pode mudar o que foi vendido ontem.
  ///
  /// Nulo é pedido anterior ao congelamento. Para esses, a disponibilidade
  /// continua lendo a composição atual do kit — é o que sempre fez, e é o
  /// dado de menor confiabilidade: se o kit mudou depois da venda, o
  /// histórico desse pedido mudou junto. Não se reconstrói: não há registro
  /// confiável de qual era a composição na época.
  kitCongeladoEm DateTime?

  total     Decimal  @default(0) @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kit         Kit?           @relation(fields: [kitId], references: [id])
  items       OrderItem[]
  kitItems    OrderKitItem[]
  reservation Reservation?
  payments    Payment[]

  @@index([kitId])
  @@map("orders")
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  productId         String
  quantity          Int     @default(1)
  unitPriceSnapshot Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@map("order_items")
}

/// A composição do kit como ela era quando o pedido foi fechado.
///
/// Tabela própria, e não linhas em `OrderItem`: o mesmo produto pode vir
/// dentro do kit e também como adicional, e `OrderItem` só admite um por
/// pedido. Aqui cada lado guarda a sua quantidade, e o compromisso é a soma
/// dos dois — a mesa do kit e a mesa extra saem do mesmo estoque.
model OrderKitItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_kit_items")
}

model Reservation {
  id          String            @id @default(cuid())
  orderId     String            @unique
  eventDate   DateTime
  status      ReservationStatus @default(PENDING)
  requestedAt DateTime          @default(now())
  confirmedAt DateTime?

  /// Número do contrato, impresso no comprovante que a cliente guarda.
  ///
  /// Vem de uma sequência do banco, e não de uma contagem feita na
  /// aplicação: duas reservas fechadas no mesmo segundo pegariam o mesmo
  /// número se alguém contasse linhas para decidir o próximo. É o banco que
  /// garante que cada contrato tem um número só seu.
  ///
  /// O ano não entra no número, entra na data do contrato ao lado. Um
  /// número que reinicia todo ano exigiria contador por ano; um que não
  /// reinicia mas carrega o ano ("FE-2027-0043") diria que houve 43
  /// contratos em 2027, o que seria mentira.
  ///
  /// Int, e não BigInt: BigInt não sobrevive a `JSON.stringify` e derrubava
  /// a lista de reservas com erro 500. Um inteiro do Postgres comporta dois
  /// bilhões de contratos — o limite que a Festaê não vai alcançar.
  contractSeq Int @unique @default(autoincrement())

  /// Quem cancelou e quando.
  ///
  /// Cancelar libera data e material, e é a operação inteira que sente o
  /// efeito. Sem registro de autoria, "por que essa data abriu?" vira uma
  /// pergunta sem resposta — e alguém remarca por cima de uma decisão que
  /// não sabe que existiu.
  cancelledAt   DateTime?
  cancelledById String?

  /// De quando esta festa foi remarcada, e quando a mudança aconteceu.
  ///
  /// Importa porque remarcar deixa rastro fora do sistema: o arquivo de
  /// calendário que alguém já baixou continua com a data velha, e o checklist
  /// pode ter sido feito pensando no outro dia. A tela avisa que houve
  /// mudança, em vez de deixar a operação descobrir no dia errado.
  rescheduledAt   DateTime?
  rescheduledFrom DateTime?

  notes String?

  /// Se esta reserva passou pelas regras comerciais vigentes.
  origemDoRegistro OrigemDoRegistro @default(OPERACAO)

  /// Chave do contrato no sistema de origem, quando veio de migração.
  ///
  /// É o que torna a carga idempotente: rodar de novo reconhece o contrato
  /// que já entrou em vez de criar uma segunda festa no mesmo dia.
  referenciaExterna String? @unique

  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cancelledBy User?              @relation("ReservasCanceladas", fields: [cancelledById], references: [id], onDelete: SetNull)
  orcamento   Orcamento?
  tasks       ReservationTask[]
  excecoes    ExcecaoComercial[]

  @@index([eventDate])
  @@index([cancelledById])
  @@map("reservations")
}

/// Uma tarefa operacional concluída numa reserva.
///
/// A linha só existe quando a tarefa foi feita — marcar cria, desmarcar
/// apaga. É mais simples que nascer com oito linhas pendentes por reserva,
/// e responde a mesma pergunta: o que já foi conferido e o que falta.
///
/// Guarda quem concluiu por vínculo, e não por cópia do nome: se a conta da
/// pessoa for excluída, o nome dela precisa sumir daqui junto (LGPD), e uma
/// cópia sobreviveria à exclusão.
model ReservationTask {
  id            String   @id @default(cuid())
  reservationId String
  /// Chave da tarefa (ver RESERVATION_TASKS em @festae/shared).
  key           String
  doneAt        DateTime @default(now())
  doneById      String?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  doneBy      User?       @relation(fields: [doneById], references: [id], onDelete: SetNull)

  @@unique([reservationId, key])
  @@index([doneById])
  @@map("reservation_tasks")
}

model Partner {
  id           String      @id @default(cuid())
  name         String
  type         PartnerType
  contactEmail String?
  contactPhone String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  products Product[]

  @@map("partners")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  type              PaymentType   @default(DEPOSIT)
  amount            Decimal       @db.Decimal(10, 2)
  method            PaymentMethod @default(PIX)
  status            PaymentStatus @default(PENDING)
  externalReference String?
  checkoutUrl       String?
  pixQrCode         String?
  pixQrCodeBase64   String?

  /// Quando o QR deixa de ser pago. Um Pix vencido não pode ser quitado,
  /// e é isso que torna seguro liberar a data reservada por ele.
  expiresAt DateTime?

  /// Última vez que perguntamos o status ao Mercado Pago. Existe para a
  /// consulta ativa não virar uma chamada à API a cada 5 segundos por
  /// cliente com a tela aberta.
  syncedAt DateTime?

  paidAt    DateTime?
  createdAt DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@map("analytics_events")
}

// ---------- Financeiro ----------

/// O que o dinheiro que saiu virou.
///
/// Não é categoria contábil: é a pergunta que a operação faz. Um painel
/// romano continua valendo depois da festa e pode ser alugado de novo; um
/// rolo de fita de cetim acaba; um anúncio no Meta nem chega a existir como
/// coisa. As três respostas entram de formas diferentes no resultado, e é
/// por isso que a distinção é um campo do lançamento, e não a aba onde
/// alguém digitou.
enum NaturezaDoGasto {
  /// Vira patrimônio alugável. Não é despesa do mês: é capital que fica.
  ACERVO

  /// Some na festa — balão, fita, cola, linha, tinta, sacola. É custo de
  /// entregar a festa, e pertence ao mês em que foi gasto.
  CONSUMO

  /// Mantém a empresa de pé sem virar coisa nem festa — anúncio, domínio,
  /// assinatura, imposto, curso, uniforme. Despesa do mês, sempre.
  CUSTEIO
}

/// Dinheiro que saiu da Festaê.
///
/// Uma tabela só, e não duas. O painel antigo separava "Contas" de
/// "Aportes" em abas diferentes, e era essa separação que produzia o erro
/// central do financeiro: o cálculo de despesa só lia a aba Contas, então
/// cada balão comprado como "aporte" sumia do resultado do mês *e* inflava
/// o capital investido que alimenta o ROI. O lucro exibido chegava a ficar
/// quase três vezes maior que o real.
///
/// Aqui a diferença entre comprar um painel e comprar um rolo de fita é
/// `natureza` — um campo do lançamento, que o cálculo lê. Não existe lugar
/// onde digitar errado esconda o gasto do resultado.
///
/// Ver docs/SPRINT-0-PAINEL-FINANCEIRO.md §4.1d.
model Gasto {
  id        String          @id @default(cuid())
  descricao String
  natureza  NaturezaDoGasto
  valor     Decimal         @db.Decimal(10, 2)

  /// Quando o dinheiro saiu de fato. Nulo enquanto não foi pago.
  ///
  /// É este campo que separa "a pagar" de "pago" — não existe status ao
  /// lado que possa discordar dele. O painel antigo guardava o quanto num
  /// campo e o se num outro, e os dois discordavam sem que nada acusasse
  /// (§8.1). Aqui a pergunta "saiu?" tem uma resposta só.
  pagoEm DateTime?

  /// Quando vence. Serve para a tela ordenar o que ainda falta pagar.
  venceEm DateTime?

  categoria        String?
  formaDePagamento String?
  observacao       String?

  /// De quem foi comprado. Texto livre de propósito: a operação compra de
  /// marketplace, de loja física e de vendedor de Instagram, e um cadastro de
  /// fornecedor obrigatório faria a pessoa inventar um nome só para conseguir
  /// salvar o lançamento.
  fornecedor String?

  /// Quantos meses este item de acervo deve durar, e quanto se espera que
  /// valha no fim.
  ///
  /// Nenhum cálculo os usa hoje — o resultado gerencial **não considera
  /// depreciação**, e a tela diz isso. Existem para que o dado comece a ser
  /// coletado agora: depreciação calculada sobre estimativa inventada seria
  /// pior que depreciação nenhuma, porque pareceria precisa.
  ///
  /// Só fazem sentido com `natureza = ACERVO`. Consumo e custeio não duram.
  vidaUtilMeses Int?
  valorResidual Decimal? @db.Decimal(10, 2)

  /// Chave estável do registro de origem, quando veio do painel antigo.
  ///
  /// Existe para a carga poder rodar duas vezes sem duplicar nada: a
  /// segunda execução reconhece o que já entrou. Nulo para tudo que for
  /// lançado daqui pra frente.
  referenciaExterna String? @unique

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([pagoEm])
  @@index([natureza])
  @@map("gastos")
}

/// A meta de lucro de um mês.
///
/// Um registro por mês, e não um valor global como no painel antigo. Lá a
/// meta era um número só: mudá-la para outubro reescrevia retroativamente
/// se agosto e setembro tinham batido ou não. Uma meta que muda o passado
/// não serve para cobrar o presente.
model MetaMensal {
  id String @id @default(cuid())

  /// O mês, como "2026-09".
  competencia String  @unique
  lucroAlvo   Decimal @db.Decimal(10, 2)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("metas_mensais")
}

/// Uma regra comercial que foi deixada de lado nesta reserva, e por quê.
///
/// Não é campo na reserva porque uma reserva pode ter mais de uma, e porque a
/// pergunta interessante é pela regra e não pela reserva: "quantas entregas
/// fora da cidade atendida já fizemos, e a que custo?" só tem resposta se a
/// exceção for uma linha consultável.
///
/// A cidade, o cliente e o valor são dados — nenhuma regra os cita pelo nome.
/// O que ganha nome estável é a regra excepcionada, para poder ser agrupada.
///
/// Serve também para exceção negociada numa venda nova, sem conceito novo: a
/// regra bloqueia, a menos que venha uma exceção autorizada junto. A regra
/// geral continua valendo para todo o resto.
model ExcecaoComercial {
  id            String @id @default(cuid())
  reservationId String

  /// Qual regra. Chave estável, não texto livre — texto livre não se agrupa.
  regra String

  /// O que foi combinado, em português, para quem ler daqui a dois anos.
  justificativa String

  /// Se a exceção foi provada pelo dado ou declarada por uma pessoa.
  ///
  /// Importa porque as duas têm peso diferente numa auditoria: "a entrega saiu
  /// de Chapecó" está na exportação e é verificável; "a taxa foi cortesia"
  /// depende da memória de quem fechou a venda.
  origemDaInformacao String @default("declarada")

  /// Quem decidiu. Nulo quando a decisão é anterior ao sistema.
  autorizadaPorId String?
  autorizadaEm    DateTime @default(now())

  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  autorizadaPor User?       @relation("ExcecoesAutorizadas", fields: [autorizadaPorId], references: [id], onDelete: SetNull)

  /// A mesma regra não se registra duas vezes na mesma reserva: é o que deixa
  /// a carga rodar de novo sem empilhar exceção repetida.
  @@unique([reservationId, regra])
  @@index([regra])
  @@index([autorizadaPorId])
  @@map("excecoes_comerciais")
}

/// Em que pé está a proposta.
///
/// RASCUNHO é o que ainda está sendo montado e ninguém viu. ENVIADO é o que
/// já tem link na mão da cliente — e por isso não pode mais ser reescrito em
/// silêncio. APROVADO e RECUSADO fecham a negociação; EXPIRADO é derivado da
/// validade, e existe como estado para a lista poder separá-lo do que ainda
/// está de pé.
enum StatusDoOrcamento {
  RASCUNHO
  ENVIADO
  APROVADO
  RECUSADO
  EXPIRADO
}

/// Por que a proposta não virou venda.
///
/// Lista curta de propósito, com OUTRO e o texto livre ao lado para o que
/// não couber. Lista longa produz estatística bonita e falsa: a pessoa
/// escolhe o primeiro item parecido para conseguir salvar.
enum CategoriaDaPerda {
  PRECO
  DATA_INDISPONIVEL
  FECHOU_COM_OUTRO
  DESISTIU
  SEM_RESPOSTA
  OUTRO
}

/// O que cada linha da proposta é.
///
/// MANUAL é a linha digitada na hora ("Arco orgânico personalizado"), que
/// existe porque a Festaê vende o que ainda não está cadastrado. Ela não tem
/// `productId` de propósito: virar produto do acervo é decisão de catálogo,
/// não efeito colateral de uma proposta.
enum TipoDaLinha {
  KIT
  PRODUTO
  BALOES
  SERVICO
  MONTAGEM
  ENTREGA
  MANUAL
}

/// Uma proposta comercial.
///
/// Não é uma reserva: orçamento não segura data nem peça. É por isso que a
/// conversão em `Reservation + Order` acontece num passo explícito, depois da
/// aprovação, passando pela mesma validação de disponibilidade da venda
/// manual. Se o balão acabou entre a proposta e o aceite, o sistema tem de
/// dizer isso em vez de reservar o que não existe.
model Orcamento {
  id String @id @default(cuid())

  /// Número que a cliente vê. Sequência do banco, como o contrato.
  numero Int               @unique @default(autoincrement())
  versao Int               @default(1)
  status StatusDoOrcamento @default(RASCUNHO)

  /// A chave do link público. Aleatória e longa: o link é a única barreira
  /// entre a proposta e quem tiver o endereço, então não pode ser adivinhável
  /// nem sequencial.
  token String @unique

  /// Cliente do cadastro, quando já existe. Nulo para quem ainda não é
  /// cliente — a proposta vem antes da conta.
  userId String?

  /// Cópia dos dados de contato no momento da proposta. Não é duplicação
  /// preguiçosa: a proposta é um documento, e documento não muda de
  /// destinatário porque alguém corrigiu o cadastro depois.
  clienteNome     String
  clienteTelefone String
  clienteEmail    String?

  festaEm     DateTime
  tipoDeFesta EventType @default(ANIVERSARIO)
  cidade      String    @default("Chapecó")
  local       String?
  convidados  Int?
  observacoes String?

  /// Até quando a proposta vale. Depois disso ela continua legível, mas não
  /// aprovável: preço de festa muda, e proposta sem prazo vira preço eterno.
  validoAte DateTime

  themeId String?
  kitId   String?

  /// Se a proposta mostra o preço de cada linha para a cliente.
  ///
  /// Desligado por padrão, e não é economia de tela: proposta com preço
  /// item a item convida a cliente a desmontar o conjunto e comparar peça
  /// por peça com quem não monta nem entrega. O que está sendo vendido é a
  /// festa pronta. A composição continua listada — o que some é o preço de
  /// cada parte, que segue inteiro no painel para quem calcula.
  mostrarValoresIndividuais Boolean @default(false)

  /// Percentual do sinal desta proposta. Nulo usa o padrão configurado no
  /// painel — gravar a taxa em toda proposta faria a mudança do padrão não
  /// alcançar nenhuma das que já existem.
  percentualDoSinal Decimal? @db.Decimal(5, 2)

  /// As imagens escolhidas para esta proposta, em ordem de exibição.
  /// Escolhidas, e não herdadas: nem toda foto do catálogo serve para toda
  /// cliente.
  imagens String[] @default([])

  subtotal Decimal @default(0) @db.Decimal(10, 2)
  desconto Decimal @default(0) @db.Decimal(10, 2)
  entrega  Decimal @default(0) @db.Decimal(10, 2)
  montagem Decimal @default(0) @db.Decimal(10, 2)

  /// O valor oficial da proposta: o que a cliente vê, aprova e paga, e o que
  /// vira o total do pedido na conversão. Quando não há negociação, é igual a
  /// `totalCalculado`.
  total Decimal @default(0) @db.Decimal(10, 2)

  /// A soma da composição, preservada mesmo quando o valor final é outro.
  ///
  /// A Maria Luiza negocia: arredonda para baixo para fechar, cobra a mais
  /// por uma personalização. Redistribuir essa diferença entre os itens
  /// falsificaria o preço de cada peça, e chamá-la de "desconto" seria mentir
  /// quando ela é acréscimo. Então os dois valores ficam: a composição, que
  /// diz como o preço foi montado, e o total, que é o que vale.
  totalCalculado Decimal @default(0) @db.Decimal(10, 2)

  /// Se o valor final foi digitado à mão.
  ///
  /// É o que decide o comportamento ao mexer na composição: valor automático
  /// acompanha a nova soma, valor negociado não é sobrescrito em silêncio.
  valorFinalManual Boolean @default(false)

  /// Por onde a cliente chegou.
  ///
  /// Nulo é "não informado", e não um canal: é o que vale para as propostas
  /// anteriores a este campo e para quem não souber dizer. Na conversão o
  /// canal é exigido — a venda nasce com a origem declarada, nunca com uma
  /// escolhida pelo sistema.
  canal SaleChannel?

  /// A composição do kit como a cliente a recebeu: nome do kit e cada peça
  /// com a quantidade, congelados no envio. Informativa — não é item, não
  /// tem preço, não compromete estoque. Nula em rascunho (a tela lê o
  /// catálogo ao vivo) e em proposta enviada antes deste campo existir
  /// (aí a composição não é mostrada: o que ela era na época não se sabe).
  composicaoDoKit Json?

  /// O primeiro envio, que nunca muda.
  ///
  /// `enviadoEm` é o envio da versão atual: editar uma proposta enviada a
  /// devolve a rascunho e zera o campo. Sem este, o tempo entre o primeiro
  /// contato e o aceite seria medido a partir do último reenvio. Nulo nas
  /// propostas enviadas antes de ele existir — a data verdadeira não está
  /// em lugar nenhum, e uma inventada seria pior que nenhuma.
  primeiroEnvioEm DateTime?

  enviadoEm  DateTime?
  aprovadoEm DateTime?
  recusadoEm DateTime?

  /// Por que se perdeu. Campo livre e opcional: obrigar a escolher um motivo
  /// de uma lista curta produz estatística bonita e falsa.
  motivoDaPerda String?

  /// A categoria da perda, que se agrupa. Nula nas perdas registradas antes
  /// dela existir: não se deduz a categoria de um texto antigo.
  categoriaDaPerda CategoriaDaPerda?

  /// Evidência de quem aprovou, do lado do cliente. Não é assinatura
  /// eletrônica com valor jurídico — é registro de manifestação, e a tela diz
  /// exatamente isso para não prometer o que não é.
  aprovadoPorNome   String?
  aprovadoPorIp     String?
  aprovadoPorAgente String?
  valorAprovado     Decimal? @db.Decimal(10, 2)

  /// A reserva que nasceu desta proposta. Um para um: proposta aprovada vira
  /// uma venda, não várias.
  reservationId String? @unique

  criadoPorId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  theme       Theme?             @relation(fields: [themeId], references: [id])
  kit         Kit?               @relation(fields: [kitId], references: [id])
  reservation Reservation?       @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  itens       OrcamentoItem[]
  versoes     OrcamentoVersao[]

  @@index([status])
  @@index([festaEm])
  @@index([userId])
  @@map("orcamentos")
}

/// Uma linha da proposta.
model OrcamentoItem {
  id          String      @id @default(cuid())
  orcamentoId String
  tipo        TipoDaLinha @default(PRODUTO)

  /// Existe quando a linha veio do catálogo. É ele que permite conferir
  /// disponibilidade na conversão — linha manual não tem, e por isso não
  /// entra na checagem de estoque.
  productId String?

  descricao     String
  quantidade    Int     @default(1)
  valorUnitario Decimal @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)
  imagemUrl     String?
  ordem         Int     @default(0)

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])

  @@index([orcamentoId])
  @@index([productId])
  @@map("orcamento_itens")
}

/// A fotografia de uma versão que já saiu para a cliente.
///
/// Proposta enviada não se reescreve por cima: a cliente tem na mão um valor
/// e uma composição, e "R$ 1.200 virou R$ 1.050" precisa continuar legível
/// depois. Guardamos o documento inteiro em JSON — é histórico para leitura,
/// não estrutura para consultar.
model OrcamentoVersao {
  id          String   @id @default(cuid())
  orcamentoId String
  versao      Int
  total       Decimal  @db.Decimal(10, 2)
  conteudo    Json
  criadoEm    DateTime @default(now())

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@unique([orcamentoId, versao])
  @@map("orcamento_versoes")
}

/// Conteúdo institucional da proposta, editável pelo painel.
///
/// Uma tabela chave-valor em vez de um CMS: são oito blocos de texto e duas
/// fotos, e qualquer coisa maior que isso seria estrutura demais para o
/// problema. Deixar no código obrigaria um deploy para trocar a foto da Maria
/// Luiza.
model ConteudoInstitucional {
  chave       String   @id
  titulo      String?
  texto       String?
  imagemUrl   String?
  atualizadoEm DateTime @updatedAt

  @@map("conteudo_institucional")
}

{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/backend/Dockerfile",
    "watchPatterns": [
      "apps/backend/**",
      "packages/database/**",
      "packages/shared/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "turbo.json",
      "railway.avisos.json"
    ]
  },
  "deploy": {
    "startCommand": "node apps/backend/dist/tarefas/contas-a-pagar.js",
    "cronSchedule": "0 * * * *",
    "restartPolicyType": "NEVER"
  }
}

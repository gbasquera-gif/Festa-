DATABASE_URL="postgresql://festae:festae_dev_password@localhost:5432/festae_dev"
PORT=3333

# Assina os tokens de sessão. A API não sobe sem ele (mínimo 16 caracteres).
# Em produção use um valor aleatório e secreto: quem souber este segredo
# consegue forjar um token de administrador. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="apenas-para-desenvolvimento-local"

# Administrador do painel. O seed só o cria numa instalação sem nenhum ADMIN;
# depois, a conta é do painel e um reinício não muda senha, papel nem situação.
# Para recuperar o acesso, defina SEED_ADMIN_RECUPERACAO com um identificador
# do pedido (ex.: 2026-10-22-senha-perdida): o seed aplica uma vez, troca a
# senha por esta, devolve o papel ADMIN e encerra as sessões abertas.
SEED_ADMIN_EMAIL="contato@festaechapeco.com.br"
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="Guilherme"

# Catálogo e contas de exemplo. Deixe ligado no desenvolvimento; em
# produção mantenha desligado, senão o catálogo de demonstração aparece
# para o cliente final.
SEED_DEMO_DATA=true

# URL pública da API — usada para montar a URL das imagens quando o upload
# cai no disco local (só desenvolvimento).
PUBLIC_URL="http://localhost:3333"

# Object storage das imagens do catálogo. OBRIGATÓRIO em produção: sem
# isso os uploads vão para o disco do container, que é apagado a cada
# deploy — as fotos de kits e produtos somem no restart seguinte.
#
# Compatível com qualquer serviço S3. No Cloudflare R2:
#   S3_ENDPOINT   https://<account_id>.r2.cloudflarestorage.com
#   S3_REGION     auto
#   S3_PUBLIC_URL o domínio público do bucket (r2.dev ou domínio próprio)
# Na AWS S3, deixe S3_ENDPOINT vazio e preencha a região de verdade.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_ENDPOINT=
S3_REGION=auto
# Só para S3 self-hosted (MinIO), onde o bucket vai no caminho da URL.
S3_FORCE_PATH_STYLE=false

# Mercado Pago — Checkout Transparente com Pix. Sem isso o pagamento fica
# indisponível (a reserva continua funcionando; o pagamento é combinado
# manualmente). Access Token de produção em
# https://www.mercadopago.com.br/developers/panel → sua aplicação →
# Credenciais de produção. Começa com APP_USR-.
MP_ACCESS_TOKEN=

# Assinatura secreta mostrada ao cadastrar o webhook, na mesma tela. Sem
# ela a API aceita a notificação assim mesmo (forjar um "pago" continua
# impossível, porque o status é sempre buscado na API do Mercado Pago),
# mas qualquer um pode nos fazer consultar a API deles em looping.
# URL a cadastrar lá: https://SEU-DOMINIO/api/v1/payments/webhook/mercadopago
# Evento a marcar: Pagamentos.
MP_WEBHOOK_SECRET=

# Capacidade operacional: quantas festas a Festaê atende por dia.
# Decisão de negócio, não limite técnico. Vazio = 2.
MAX_RESERVATIONS_PER_DAY=2

# Assistente IA do painel (só leitura). A chave fica SÓ aqui no servidor —
# nunca no painel nem no código. Gere em https://platform.openai.com →
# API keys, num projeto só para a Festaê, com limite de gasto mensal.
# Sem chave: em desenvolvimento roda o modo de demonstração; em produção o
# botão do assistente não aparece. Desligar: ASSISTENTE_IA_PROVEDOR=desligado
# (no próximo deploy) ou revogar a chave na OpenAI (na hora).
OPENAI_API_KEY=
# openai | simulado | desligado. Vazio = openai se houver chave.
# "simulado" (demonstração) é recusado em produção.
ASSISTENTE_IA_PROVEDOR=
# Modelos (vazio = padrão do código). Confira os preços antes de trocar.
ASSISTENTE_IA_MODELO=
ASSISTENTE_IA_MODELO_TRANSCRICAO=
ASSISTENTE_IA_MODELO_VOZ=
# Ignorada por enquanto: a resposta falada usa sempre a voz do aparelho (custo
# zero). A voz gerada na OpenAI está bloqueada porque leria os nomes reais.
ASSISTENTE_IA_SAIDA_DE_VOZ=
# Limites por pessoa (vazio = 30 por hora, 150 por dia) e da Festaê inteira
# (1500 por dia). Contados no banco: valem com qualquer número de instâncias.
ASSISTENTE_IA_PERGUNTAS_POR_HORA=
ASSISTENTE_IA_PERGUNTAS_POR_DIA=
ASSISTENTE_IA_PERGUNTAS_POR_DIA_TOTAL=
# Teto de gasto estimado em US$ (vazio = 2 por dia, 20 por mês). Ao atingir,
# o assistente recusa novas perguntas até virar o dia/mês. Não substitui o
# limite de gasto do projeto na OpenAI, que é o teto definitivo.
ASSISTENTE_IA_GASTO_MAXIMO_DIA_USD=
ASSISTENTE_IA_GASTO_MAXIMO_MES_USD=

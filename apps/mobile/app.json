{
  "expo": {
    "name": "Festaê!",
    "slug": "festae-app",
    "scheme": "festae",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0F2A4F",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#0F2A4F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.festae.app"
    },
    "android": {
      "package": "com.festae.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F2A4F",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0F2A4F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ebbdde33-98f7-4270-bf7a-28e04d992d24"
      }
    },
    "owner": "guifestaes-team"
  }
}

{
  "name": "festae-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev",
    "dev:site": "turbo run dev --filter=@festae/site",
    "dev:backend": "turbo run dev --filter=@festae/backend",
    "dev:admin": "turbo run dev --filter=@festae/admin",
    "dev:mobile": "turbo run dev --filter=@festae/mobile",
    "build": "turbo run build",
    "check": "turbo run check",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @festae/database run generate",
    "db:migrate": "pnpm --filter @festae/database run migrate",
    "db:seed": "pnpm --filter @festae/database run seed"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "5.6.3"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "patchedDependencies": {
      "wouter@3.7.1": "patches/wouter@3.7.1.patch"
    },
    "overrides": {
      "tailwindcss>nanoid": "3.3.7"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "esbuild",
      "prisma"
    ]
  }
}
